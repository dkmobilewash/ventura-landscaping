# --- Resend email automation (form submissions) ---
# Create an API key at https://resend.com (Settings > API Keys) and paste it here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where leads are delivered (optional — defaults to dcarrillo0422@gmail.com)
